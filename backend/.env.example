# Leave MONGO_URL empty to run on the in-memory demo database.
MONGO_URL=
DB_NAME=job_os
JWT_SECRET=change-me-to-a-long-random-string
SEED_DEMO=true          # load the demo business on an empty database
DEMO_MODE=true          # one-click demo logins; set false for a real customer
CORS_ORIGINS=*
PAYMENTS_PROVIDER=demo  # stripe when connected
# Text messaging (two-way). Without these, texts are saved but not delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_COUNTRY_CODE=1      # added to numbers typed without a +
PUBLIC_API_URL=         # e.g. https://yourapp.com, needed for Twilio signature checks behind a proxy
# AI: any one powers "Ask"; each one adds an assistant to the AI visibility check.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
EMAIL_PROVIDER=log      # resend / smtp when connected
